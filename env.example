# Copy to .env and change the password before starting PostgreSQL.
# Never commit the real .env file.

# --- docker compose (PostgreSQL container) ---
POSTGRES_DB=mstp
POSTGRES_USER=mstp
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_APP_USER=mstp_app
POSTGRES_APP_PASSWORD=<application-db-password>

# --- Java application (read by com.mmtrip.shared.Db) ---
MHT_DB_URL=jdbc:postgresql://localhost:5432/mstp
MHT_DB_USER=mstp
MHT_DB_PASSWORD=change-me
MHT_DB_POOL_SIZE=10
MHT_DB_CONNECTION_TIMEOUT_MS=5000

# Optional: extra browser origins allowed by the gateway (comma separated).
# MHT_ALLOWED_ORIGINS=https://example.com

# --- RMI (Phase 3: private Docker DNS, never public) ---
MHT_RMI_HOST=127.0.0.1
MHT_RMI_HOSTNAME=127.0.0.1
MHT_RMI_REGISTRY_PORT=1099
MHT_RMI_SERVICE_PORT=1100

# --- HTTP gateway / runtime data ---
MHT_HTTP_PORT=8080
MHT_DATA_DIR=data
MHT_UPLOAD_DIR=web/images/hotels
MHT_DEMO=false
MHT_TRUST_PROXY=false

# --- encrypted backups (never commit real values) ---
RESTIC_REPOSITORY=<off-site-restic-repository>
RESTIC_PASSWORD=<backup-password>
# RESTIC_PASSWORD_FILE=/path/to/protected/password-file

